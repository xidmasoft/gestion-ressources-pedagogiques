# Désactiver l'exécution du moteur PHP dans ce répertoire
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Bloquer l'accès à certains types de fichiers potentiellement dangereux
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Forcer le téléchargement plutôt que l'affichage dans le navigateur pour plus de sécurité
<FilesMatch "\.(pdf|doc|docx|xls|xlsx|ppt|pptx|jpg|jpeg|png)$">
    Header set Content-Disposition attachment
</FilesMatch>
